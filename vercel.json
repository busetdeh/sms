{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/reporting",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" }]
    },
    {
      "source": "/benteng-speelwijk",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" }]
    },
    {
      "source": "/benteng-speelwijk-profile",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" }]
    },
    {
      "source": "/benteng-speelwijk-profile-eng",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" }]
    },
    {
      "source": "/pages/benteng-speelwijk",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/reporting", "destination": "/reporting.html" },
    { "source": "/pages/admin", "destination": "/pages/admin.html" },
    { "source": "/tentang-kami", "destination": "/pages/tentang-kami.html" },
    { "source": "/galeri", "destination": "/pages/galeri.html" },
    { "source": "/spot-terbang", "destination": "/pages/spot-terbang.html" },
    { "source": "/kontak", "destination": "/pages/kontak.html" },
    { "source": "/artikel", "destination": "/pages/artikel.html" },
    { "source": "/sms-fly-through-history", "destination": "/benteng-speelwijk" },
    { "source": "/benteng-speelwijk-profile", "destination": "/benteng-speelwijk-profile.html" },
    { "source": "/benteng-speelwijk-profile-eng", "destination": "/benteng-speelwijk-profile-eng.html" },
    { "source": "/pages/benteng-speelwijk-profile", "destination": "/pages/benteng-speelwijk-profile.html" },
    { "source": "/pages/benteng-speelwijk-profile-eng", "destination": "/pages/benteng-speelwijk-profile-eng.html" },
    { "source": "/pages/sms-fly-through-history", "destination": "/pages/benteng-speelwijk" },
    { "source": "/pages/tentang-kami", "destination": "/pages/tentang-kami.html" },
    { "source": "/pages/galeri", "destination": "/pages/galeri.html" },
    { "source": "/pages/spot-terbang", "destination": "/pages/spot-terbang.html" },
    { "source": "/pages/kontak", "destination": "/pages/kontak.html" },
    { "source": "/pages/artikel", "destination": "/pages/artikel.html" },
    { "source": "/pages/:slug([a-zA-Z0-9_-]+)", "destination": "/pages/benteng-speelwijk.html" },
    { "source": "/:slug([a-zA-Z0-9_-]+)", "destination": "/benteng-speelwijk.html" }
  ]
}
